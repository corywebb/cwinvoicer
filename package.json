{
  "name": "cwinvoicer",
  "version": "1.2.0",
  "private": true,
  "productName": "CW Invoicer",
  "description": "Local invoicing for Cory Webb Media. Data stored as JSON files.",
  "author": "Cory Webb Media",
  "main": "out/electron/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "prestart": "npm run build",
    "start": "node out/server/index.js --open",
    "preapp": "npm run build",
    "app": "electron .",
    "predist": "npm run typecheck && npm run build",
    "dist": "electron-builder --mac",
    "pretest": "npm run build",
    "test": "node --test",
    "predemo": "npm run build",
    "demo": "node scripts/demo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.corywebbmedia.cwinvoicer",
    "productName": "CW Invoicer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "public/**",
      "!public/app.js.map",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "CW Invoicer"
    }
  }
}
